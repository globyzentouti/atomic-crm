# PLACEHOLDERS ONLY. Do not put real credentials in this tracked example.
# Existing local setup already has .env.development; do not overwrite it.
# For a new setup, copy this file to .env.local (ignored by Git), then fill
# values privately. Never put a service-role key or provider secret in VITE_*.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SB_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_IS_DEMO=false
VITE_ATTACHMENTS_BUCKET=attachments
# Optional inbound-email address; leave empty when not configured.
VITE_INBOUND_EMAIL=

# No AI, Resend or WhatsApp API secrets are needed in Phase 0.
# Later approved integrations use Supabase Edge Function secrets only.
